    "corpus": "node scripts/build-corpus.mjs",
    "start": "npm run build && node dist/src/eval/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },

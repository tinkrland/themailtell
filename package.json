{
  "name": "thelocaletell",
  "version": "0.1.0",
  "description": "delivery-address shape detection: signals and evidence, not verdicts",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
